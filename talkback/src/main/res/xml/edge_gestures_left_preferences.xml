<?xml version="1.0" encoding="UTF-8"?>
<!-- The left edge's gestures and hidden menu. Keys must match EdgeGestureSettings. The menu
     items get their titles in EdgeGesturesFragment. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_category_edge_left_gestures"
      android:title="@string/title_pref_category_edge_gesture_actions">
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_swipe_up"
        android:summary="%s"
        android:title="@string/title_pref_shortcut_up"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_swipe_down"
        android:summary="%s"
        android:title="@string/title_pref_shortcut_down"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_triple_tap"
        android:summary="%s"
        android:title="@string/title_pref_edge_triple_tap"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_category_edge_left_menu"
      android:title="@string/title_pref_category_edge_menu">
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_1"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_2"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_3"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_4"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_5"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_6"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_7"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_8"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_9"
        android:summary="%s"/>
    <com.google.android.accessibility.talkback.preference.base.GestureListPreference
        android:defaultValue="@string/shortcut_value_unassigned"
        android:key="pref_edge_left_menu_10"
        android:summary="%s"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
